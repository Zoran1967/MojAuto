#:import dp kivy.metrics.dp
<DatabaseScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 15
        spacing: 10

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: 10
            Button:
                size_hint_x: None
                width: dp(110)
                background_normal: "assets/nazad_btn.png"
                background_down: "assets/nazad_btn.png"
                on_release: root.go_back()
            Label:
                text: "Baza proizvoda i prodavnica"
                font_size: "15sp"

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: 8
            PrimaryButton:
                text: "Proizvodi"
                on_release: root.show_proizvodi()
            PrimaryButton:
                text: "Prodavnice"
                on_release: root.show_prodavnice()

        ScrollView:
            BoxLayout:
                id: database_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
