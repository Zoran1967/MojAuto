#:import dp kivy.metrics.dp
<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 30
        spacing: 18

        Label:
            text: "Soping Lista"
            font_size: "30sp"
            bold: True
            size_hint_y: 0.2

        GridLayout:
            cols: 2
            spacing: dp(16)
            size_hint_y: 0.8

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/icons/nova_lista.png"
                    allow_stretch: True
                    keep_ratio: True
                PrimaryButton:
                    text: "Nova lista\nza kupovinu"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_new_list()

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/icons/istorija.png"
                    allow_stretch: True
                    keep_ratio: True
                SecondaryButton:
                    text: "Istorija\nkupovina"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_history()

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/icons/baza.png"
                    allow_stretch: True
                    keep_ratio: True
                SecondaryButton:
                    text: "Baza proizvoda\ni prodavnica"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_database()

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/icons/podesavanja.png"
                    allow_stretch: True
                    keep_ratio: True
                SecondaryButton:
                    text: "Podesavanja"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_settings()
