#:import dp kivy.metrics.dp

<IconHomeButton@ButtonBehavior+BoxLayout>:
    bg_color: 0.2, 0.4, 0.8, 1
    icon_source: ""
    label_text: ""
    orientation: "vertical"
    padding: dp(10)
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
    Image:
        source: root.icon_source
        allow_stretch: True
        keep_ratio: True
        size_hint_y: 0.65
    Label:
        text: root.label_text
        font_size: "16sp"
        bold: True
        halign: "center"
        valign: "middle"
        text_size: self.size
        size_hint_y: 0.35


<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.06, 0.06, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(14)

        Label:
            text: "Soping Lista"
            font_size: "28sp"
            bold: True
            size_hint_y: None
            height: dp(50)

        GridLayout:
            cols: 2
            rows: 2
            spacing: dp(12)
            size_hint_y: 0.55

            IconHomeButton:
                bg_color: 0.55, 0.25, 0.75, 1
                icon_source: app.assets_dir + "icon_baza.png"
                label_text: root.txt_database
                on_release: root.go_to_database()

            IconHomeButton:
                bg_color: 0.15, 0.55, 0.25, 1
                icon_source: app.assets_dir + "icon_istorija.png"
                label_text: root.txt_history
                on_release: root.go_to_history()

            IconHomeButton:
                bg_color: 0.15, 0.45, 0.85, 1
                icon_source: app.assets_dir + "icon_nova_lista.png"
                label_text: root.txt_new_list
                on_release: root.go_to_new_list()

            IconHomeButton:
                bg_color: 0.85, 0.55, 0.1, 1
                icon_source: app.assets_dir + "icon_podesavanja.png"
                label_text: root.txt_settings
                on_release: root.go_to_settings()

        FloatLayout:
            size_hint_y: 0.45

            Image:
                source: app.assets_dir + "cart_big.png"
                allow_stretch: True
                keep_ratio: True
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                size_hint: 1, 1

            Button:
                text: "\U0001F310"
                font_size: "22sp"
                size_hint: None, None
                size: dp(48), dp(48)
                pos_hint: {"right": 0.98, "y": 0.02}
                background_normal: ""
                background_color: 0.15, 0.15, 0.18, 0.9
                on_release: root.open_language_picker()
