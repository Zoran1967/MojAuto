#:import dp kivy.metrics.dp
<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 30
        spacing: 18

        Label:
            text: "Soping Lista"
            font_size: "30sp"
            bold: True
            size_hint_y: None
            height: dp(60)

        GridLayout:
            cols: 2
            spacing: dp(16)
            size_hint_y: None
            height: dp(300)

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/nova_lista.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                PrimaryButton:
                    text: "Nova lista\nza kupovinu"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_new_list()

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/istorija.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                SecondaryButton:
                    text: "Istorija\nkupovina"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_history()

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/baza.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                SecondaryButton:
                    text: "Baza proizvoda\ni prodavnica"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_database()

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/podesavanja.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                SecondaryButton:
                    text: "Podesavanja"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_settings()

        Image:
            source: "assets/nova_lista.png"
            allow_stretch: True
            keep_ratio: True
