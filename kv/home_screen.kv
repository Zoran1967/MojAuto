#:import dp kivy.metrics.dp
<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.06, 0.06, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(14)
        Label:
            text: "TEST - da li se ovo vidi?"
            font_size: "28sp"
            bold: True
            color: 1, 1, 1, 1
        Button:
            text: root.txt_database
            font_size: "20sp"
            on_release: root.go_to_database()
        Button:
            text: root.txt_history
            font_size: "20sp"
            on_release: root.go_to_history()
        Button:
            text: root.txt_new_list
            font_size: "20sp"
            on_release: root.go_to_new_list()
        Button:
            text: root.txt_settings
            font_size: "20sp"
            on_release: root.go_to_settings()
