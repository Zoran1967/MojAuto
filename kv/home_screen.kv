#:import dp kivy.metrics.dp
<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 30
        spacing: 18

        BoxLayout:
            size_hint_y: None
            height: dp(60)
            Label:
                text: "Shopping"
                font_size: "30sp"
                bold: True
                color: 0.25, 0.55, 1, 1
                halign: "right"
                text_size: self.size
                valign: "middle"
            Label:
                text: " List"
                font_size: "30sp"
                bold: True
                color: 1, 0.55, 0.1, 1
                halign: "left"
                text_size: self.size
                valign: "middle"

        GridLayout:
            cols: 2
            spacing: dp(16)
            size_hint_y: None
            height: dp(300)

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/nova_lista.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                PrimaryButton:
                    text: "Nova lista\nza kupovinu"
                    size_hint_y: None
                    height: dp(56)
                    on_release: root.go_to_new_list()

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/istorija.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                Button:
                    text: "Istorija\nkupovina"
                    size_hint_y: None
                    height: dp(56)
                    background_normal: ""
                    background_down: ""
                    background_color: 0, 0, 0, 0
                    color: 1, 1, 1, 1
                    on_release: root.go_to_history()
                    canvas.before:
                        Color:
                            rgba: 0.20, 0.60, 0.20, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/baza.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                Button:
                    text: "Baza proizvoda\ni prodavnica"
                    size_hint_y: None
                    height: dp(56)
                    background_normal: ""
                    background_down: ""
                    background_color: 0, 0, 0, 0
                    color: 1, 1, 1, 1
                    on_release: root.go_to_database()
                    canvas.before:
                        Color:
                            rgba: 0.55, 0.25, 0.75, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

            BoxLayout:
                orientation: "vertical"
                spacing: dp(4)
                Image:
                    source: "assets/podesavanja.png"
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {"center_x": 0.5}
                Button:
                    text: "Podesavanja"
                    size_hint_y: None
                    height: dp(56)
                    background_normal: ""
                    background_down: ""
                    background_color: 0, 0, 0, 0
                    color: 1, 1, 1, 1
                    on_release: root.go_to_settings()
                    canvas.before:
                        Color:
                            rgba: 0.85, 0.55, 0.10, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(16)]

        Image:
            source: "assets/nova_lista.png"
            allow_stretch: True
            keep_ratio: True
