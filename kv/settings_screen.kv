#:import dp kivy.metrics.dp
<IconSettingsButton@ButtonBehavior+BoxLayout>:
    icon_source: ""
    label_text: ""
    orientation: "vertical"
    padding: dp(8)
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: (0, 0, 0, 0.25)
        RoundedRectangle:
            pos: self.x, self.y - dp(2)
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: app.theme.accent if self.state == "normal" else (app.theme.accent[0]*0.7, app.theme.accent[1]*0.7, app.theme.accent[2]*0.7, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
    Image:
        source: root.icon_source
        allow_stretch: True
        keep_ratio: True
        size_hint_y: 0.68
    Label:
        text: root.label_text
        font_size: "13sp"
        bold: True
        color: 1, 1, 1, 1
        halign: "center"
        valign: "middle"
        text_size: self.width, None
        size_hint_y: 0.32
<SettingsScreen>:
    FloatLayout:
        BoxLayout:
            orientation: "vertical"
            padding: [20, 20, 20, dp(80)]
            spacing: 15
            size_hint: 1, 1
            pos_hint: {"x": 0, "y": 0}

            Label:
                id: title_label
                text: "Podesavanja"
                font_size: "20sp"
                bold: True
                size_hint_y: None
                height: dp(36)

            GridLayout:
                cols: 3
                rows: 2
                spacing: dp(12)
                size_hint_y: 1

                IconSettingsButton:
                    id: tema_btn
                    icon_source: app.assets_dir + "1_tema.png"
                    label_text: "Tema (boja dugmadi)"
                    on_release: root.open_theme_popup()

                IconSettingsButton:
                    id: bg_btn
                    icon_source: app.assets_dir + "2_pozadina.png"
                    label_text: "Boja pozadine ekrana"
                    on_release: root.open_bg_popup()

                IconSettingsButton:
                    id: tekst_btn
                    icon_source: app.assets_dir + "3_tekst.png"
                    label_text: "Boja teksta u poljima"
                    on_release: root.open_input_text_popup()

                IconSettingsButton:
                    id: kurs_btn
                    icon_source: app.assets_dir + "4_kurs.png"
                    label_text: "Kurs"
                    on_release: root.open_currency_popup()

                IconSettingsButton:
                    id: backup_btn
                    icon_source: app.assets_dir + "5_bekap.png"
                    label_text: "Sacuvaj rezervnu kopiju"
                    on_release: root.napravi_backup()

                IconSettingsButton:
                    id: restore_btn
                    icon_source: app.assets_dir + "6_vrati_bekap.png"
                    label_text: "Vrati rezervnu kopiju"
                    on_release: root.vrati_backup()

        Button:
            id: back_btn
            size_hint: None, None
            size: dp(110), dp(48)
            pos_hint: {"x": 0.03, "y": 0.03}
            background_normal: "assets/nazad_prazno.png"
            background_down: "assets/nazad_prazno.png"
            on_release: root.go_back()
